      "parameters": {
        "jsCode": " const prepareNode = $node[\"Prepare LLM Request\"];\n     const question = prepareNode?.json?.question || \"\";\n     const bookCount = prepareNode?.json?.bookCount || 0;\n\n     const llmResponse = $json;\n     const answer = llmResponse.choices?.[0]?.message?.content || \"（模型未返回内容）\";\n     const model = llmResponse.model || \"unknown\";\n\n     return {\n       json: {\n         answer,\n         echoQuestion: question,\n         usedModel: model,\n         bookCount: bookCount,\n       },\n     };"
