    {
      "parameters": {
        "jsCode": "const webhookNode = $node[\"Webhook /chat\"];\nconst webhookData = webhookNode?.json?.body || {};\nconst question = webhookData.message || \"\";\nconst history = webhookData.history || [];\n\nconst mcpNode = $node[\"MCP: search books\"];\nconst books = mcpNode?.json || {};\nconst bookData = Array.isArray(books) ? books[0] : books;\n\nconst systemPrompt = `你是电子书店智能助手...`;\n\nconst historyMessages = history\n  .filter((m) => m && m.role && m.content)\n  .map((m) => ({ role: m.role, content: String(m.content) }));\n\nlet bookSnippet = \"\";\nif (bookData && bookData.results && Array.isArray(bookData.results)) {\n  const booksList = bookData.results.slice(0, 20);\n  bookSnippet = JSON.stringify({\n    count: bookData.count || 0,\n    books: booksList.map((book) => ({\n      title: book.title,\n      author: book.author,\n      price: book.price,\n      status: book.status,\n      stock: book.stock,\n      isbn: book.isbn,\n    })),\n  });\n} else {\n  bookSnippet = JSON.stringify(bookData || {});\n}\n\nif (bookSnippet.length > 6000) {\n  bookSnippet = bookSnippet.slice(0, 6000) + \"...\";\n}\n\nconst messages = [\n  { role: \"system\", content: systemPrompt },\n  ...historyMessages,\n  {\n    role: \"user\",\n    content: `用户问题：${question}\\n\\n书籍数据（来自 MCP 服务）：${bookSnippet}`,\n  },\n];\n\nreturn {\n  json: {\n    messages: messages,\n    question: question,\n    bookCount: bookData?.count || 0,\n  },\n};"
      },
      "name": "Prepare LLM Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
